{
  "name": "meridian",
  "version": "0.0.0",
  "private": true,
  "description": "Same-day binary outcome markets on stock closing prices, on Solana devnet",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/sdk",
    "packages/price-providers",
    "services/automation",
    "app"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gates": "make gates",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.1",
    "@eslint/js": "^9.39.5",
    "@meridian/sdk": "^0.0.0",
    "@next/eslint-plugin-next": "^16.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
