# Copy to .env and fill in. Never commit .env or keypair files.
# Keypair variables take a file path or a base58-encoded secret key.

# Chain
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_WS_URL=
MERIDIAN_PROGRAM_ID=
MERIDIAN_ORACLE_PROGRAM_ID=
# The worker's meridian IDL. Empty means target/idl/meridian.json from `anchor build`, else the
# copy services/automation/idl/ ships.
MERIDIAN_IDL_PATH=
USDC_MINT=
# RPC port of the `make dev` local validator; its WebSocket uses the next port. Keep it clear of
# 8899, 8900 and 9900.
LOCAL_VALIDATOR_RPC_PORT=8913
ADMIN_KEYPAIR=
AUTOMATION_KEYPAIR=
RELAY_SIGNER_1_KEYPAIR=
# Only when slot 2 runs a second relay source
RELAY_SIGNER_2_KEYPAIR=
# Program upgrade authority that `anchor deploy` uses and that bootstraps config (keypair file
# path). Empty means the Solana CLI default, ~/.config/solana/id.json.
ANCHOR_WALLET=

# Oracle slots: relay | pyth | chainlink | disabled
ORACLE_SLOT_1=relay
ORACLE_SLOT_2=disabled
# Relay sources (RELAY_<n>_SOURCE): yahoo (default, keyless chart API) | mock (replays recorded
# fixtures, works offline)
RELAY_1_SOURCE=yahoo
# Set when a second relay source exists
RELAY_2_SOURCE=

# Data sources and oracles
CHAINLINK_DATA_STEAMS_USERNAME=
CHAINLINK_HMAC_SECRET=
PYTH_ACCESS_TOKEN=

# Ops
ALERT_WEBHOOK_URL=
# Comma-separated alert sinks: console | webhook
ALERT_SINKS=console
DEMO_MODE=false

# Web
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=
NEXT_PUBLIC_MERIDIAN_ORACLE_PROGRAM_ID=
# Public key whose LatestPrice accounts the app reads
NEXT_PUBLIC_RELAY_SIGNER_1=
# Base URL the Playwright end-to-end specs open (defaults to http://localhost:3000)
E2E_BASE_URL=
