# Copy to .env and fill in. Never commit .env or keypair files.
# Keypair variables take a file path or a base58-encoded secret key.

# Chain
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_WS_URL=
MERIDIAN_PROGRAM_ID=
MERIDIAN_ORACLE_PROGRAM_ID=
# The worker's meridian IDL. Empty means target/idl/meridian.json from `anchor build`, else the
# copy services/automation/idl/ ships.
MERIDIAN_IDL_PATH=
USDC_MINT=
# RPC port of the `make dev` local validator; its WebSocket uses the next port. Keep it clear of
# 8899, 8900 and 9900.
LOCAL_VALIDATOR_RPC_PORT=8913
ADMIN_KEYPAIR=
AUTOMATION_KEYPAIR=
RELAY_SIGNER_1_KEYPAIR=
# Only when slot 2 runs a second relay source
RELAY_SIGNER_2_KEYPAIR=
# Program upgrade authority that `anchor deploy` uses and that bootstraps config (keypair file
# path). Empty means the Solana CLI default, ~/.config/solana/id.json.
ANCHOR_WALLET=

# Oracle slots: relay | pyth | chainlink | disabled
ORACLE_SLOT_1=relay
ORACLE_SLOT_2=disabled
# Relay sources (RELAY_<n>_SOURCE): alpaca (Alpaca market data, needs the keys below) | yahoo
# (keyless chart API) | mock (replays recorded fixtures, works offline). Empty means alpaca when both
# Alpaca keys are set, otherwise mock.
RELAY_1_SOURCE=
# Set when a second relay source exists
RELAY_2_SOURCE=

# Alpaca market data (RELAY_<n>_SOURCE=alpaca). ALPACA_API_ENDPOINT is the trading API, which
# market data never calls. Empty ALPACA_DATA_URL means https://data.alpaca.markets; empty
# ALPACA_STREAM_URL means wss://stream.data.alpaca.markets/v2/iex (the free plan's IEX stream).
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_API_ENDPOINT=
ALPACA_DATA_URL=
ALPACA_STREAM_URL=

# Pyth slot (ORACLE_SLOT_<n>=pyth). Feed IDs are TICKER=<64 hex digits> pairs, comma-separated,
# for example AAPL=49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688. Empty
# PYTH_HERMES_URL means https://hermes.pyth.network.
PYTH_RECEIVER_PROGRAM_ID=
PYTH_FEED_IDS=
PYTH_ACCESS_TOKEN=
PYTH_HERMES_URL=

# Chainlink Data Streams slot (ORACLE_SLOT_<n>=chainlink). Stream IDs use the same
# TICKER=<64 hex digits> format. Empty CHAINLINK_DATA_STREAMS_URL means
# https://api.dataengine.chain.link; empty CHAINLINK_ACCESS_CONTROLLER_ID means the verifier's
# published access controller.
CHAINLINK_VERIFIER_PROGRAM_ID=
CHAINLINK_STREAM_IDS=
CHAINLINK_DATA_STREAMS_USERNAME=
CHAINLINK_HMAC_SECRET=
CHAINLINK_DATA_STREAMS_URL=
CHAINLINK_ACCESS_CONTROLLER_ID=

# Ops
ALERT_WEBHOOK_URL=
# Comma-separated alert sinks: console | webhook
ALERT_SINKS=console
DEMO_MODE=false
# Port of the worker's health server. Railway sets it in production; locally 8080 keeps it clear
# of the validator and e2e ports.
PORT=8080

# Web
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=
NEXT_PUBLIC_MERIDIAN_ORACLE_PROGRAM_ID=
# Public key whose LatestPrice accounts the app reads
NEXT_PUBLIC_RELAY_SIGNER_1=
# The worker's health server, which serves the Markets chart's /prices/intraday/<ticker>
# (http://localhost:8080 locally). Unset, the cards show "Chart unavailable".
NEXT_PUBLIC_PRICE_API_URL=
# Base URL the Playwright end-to-end specs open; `make e2e` sets it (defaults to http://127.0.0.1:3105)
E2E_BASE_URL=
# JSON file describing the local e2e stack (market accounts, test keypairs); `make e2e` writes it
E2E_STACK_FILE=
# `make e2e` (scripts/e2e.ts): its private validator and web ports. Defaults stay clear of CI's
# validator block and Agave's gossip port 8000; the RPC WebSocket takes rpc port + 1.
E2E_RPC_PORT=8975
E2E_FAUCET_PORT=8977
E2E_GOSSIP_PORT=9350
E2E_DYNAMIC_PORT_RANGE=9351-9390
E2E_WEB_PORT=3105
# true reuses the last `anchor build` instead of rebuilding first
E2E_SKIP_BUILD=
# Offers the "E2E test wallet" in `next dev` for the Playwright specs; production builds never do
NEXT_PUBLIC_E2E_TEST_WALLET=
