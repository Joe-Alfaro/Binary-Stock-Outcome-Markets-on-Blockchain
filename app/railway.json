{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --no-audit --no-fund && npm run build -w app",
    "watchPatterns": ["app/**", "packages/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start -w app",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
